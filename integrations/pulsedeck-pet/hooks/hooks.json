{
  "description": "Publish fixed lifecycle states and tool categories without retaining event contents.",
  "hooks": {
    "SessionStart": [{
      "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/pet_state.sh\" ready", "timeout": 2}]
    }],
    "UserPromptSubmit": [{
      "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/pet_state.sh\" start", "timeout": 2}]
    }],
    "PreToolUse": [{
      "matcher": "*",
      "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/pet_state.sh\" tool", "timeout": 2}]
    }],
    "PermissionRequest": [{
      "matcher": "*",
      "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/pet_state.sh\" waiting", "timeout": 2}]
    }],
    "Stop": [{
      "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/pet_state.sh\" done", "timeout": 2}]
    }],
    "Interrupt": [{
      "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/pet_state.sh\" aborted", "timeout": 1}]
    }],
    "SessionEnd": [{
      "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/pet_state.sh\" offline", "timeout": 2}]
    }]
  }
}
