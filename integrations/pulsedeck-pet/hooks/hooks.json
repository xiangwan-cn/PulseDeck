{
  "description": "Update PulseDeck PetCard with fixed states without parsing or retaining event contents.",
  "hooks": {
    "SessionStart": [{
      "hooks": [{"type": "command", "command": "bash \"$PLUGIN_ROOT/scripts/pet_state.sh\" ready", "timeout": 2}]
    }],
    "UserPromptSubmit": [{
      "hooks": [{"type": "command", "command": "bash \"$PLUGIN_ROOT/scripts/pet_state.sh\" start", "timeout": 2}]
    }],
    "PreToolUse": [{
      "matcher": "*",
      "hooks": [{"type": "command", "command": "bash \"$PLUGIN_ROOT/scripts/pet_state.sh\" working", "timeout": 2}]
    }],
    "PermissionRequest": [{
      "matcher": "*",
      "hooks": [{"type": "command", "command": "bash \"$PLUGIN_ROOT/scripts/pet_state.sh\" waiting", "timeout": 2}]
    }],
    "Stop": [{
      "hooks": [{"type": "command", "command": "bash \"$PLUGIN_ROOT/scripts/pet_state.sh\" done", "timeout": 2}]
    }]
  }
}
